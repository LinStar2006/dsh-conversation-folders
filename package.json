{
  "name": "dsh-conversation-folders",
  "version": "0.4.0",
  "type": "module",
  "description": "A DSH plugin that gives every conversation its own workspace folder, migrates existing workspace files from session logs, and adds an open-conversation-folder button to the session header.",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.zh-CN.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "workspace",
    "conversation"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
